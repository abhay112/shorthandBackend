# =================================
# PRODUCTION ENVIRONMENT VARIABLES
# =================================
# Copy this file to .env on your production server
# and fill in your actual values

# =================================
# APPLICATION
# =================================
NODE_ENV=production
PORT=3000

# =================================
# DATABASE - MongoDB
# =================================
# Option 1: MongoDB Atlas (Recommended for Production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/shorthand

# =================================
# SECURITY
# =================================
# Generate a strong random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS

# =================================
# FIREBASE ADMIN SDK
# =================================
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# =================================
# FRONTEND
# =================================
# Your production frontend URL
FRONTEND_URL=https://vikalpshorthand.com

# Additional allowed origins (comma-separated)
ALLOWED_ORIGINS=https://vikalpshorthand.com,https://www.vikalpshorthand.com

# =================================
# GRAFANA
# =================================
# IMPORTANT: Change these from default values!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-THIS-TO-A-STRONG-PASSWORD

# =================================
# MONITORING
# =================================
# Loki endpoint for log shipping
LOKI_URL=http://loki:3100

# Enable/disable Loki log shipping
ENABLE_LOKI_LOGS=true

# =================================
# OPTIONAL - EMAIL (if you add email functionality)
# =================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# =================================
# OPTIONAL - AWS S3 (if you add file uploads)
# =================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# =================================
# NOTES:
# =================================
# 1. Never commit this file to git with real values
# 2. Keep backups of this file in a secure location
# 3. Use strong, unique passwords for all services
# 4. Rotate secrets regularly (every 90 days recommended)
# 5. Use environment-specific values (don't use dev values in prod)

